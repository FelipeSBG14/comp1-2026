/* Fragmentos separados para respeitar o limite de literais do C89. */
    "/* Leitura da listagem textual do TP1, sem executar novamente o scanner. */\n",
    "static FILE *arquivo_tokens;\n",
    "static char *linha_tokens;\n",
    "static size_t capacidade_tokens;\n",
    "static int numero_registro;\n",
    "static int modo_tokens;\n",
    "\n",
    "static int ler_linha_tokens(void)\n",
    "{\n",
    "    size_t n;\n",
    "    int c;\n",
    "    char *nova;\n",
    "    n = 0;\n",
    "    while ((c = fgetc(arquivo_tokens)) != EOF && c != '\\n') {\n",
    "        if (n + 1 >= capacidade_tokens) {\n",
    "            capacidade_tokens = capacidade_tokens ? capacidade_tokens * 2 : 256;\n",
    "            nova = (char *)realloc(linha_tokens, capacidade_tokens);\n",
    "            if (nova == NULL) {\n",
    "                fputs(\"erro fatal: memoria insuficiente\\n\", stderr);\n",
    "                exit(2);\n",
    "            }\n",
    "            linha_tokens = nova;\n",
    "        }\n",
    "        linha_tokens[n++] = (char)c;\n",
    "    }\n",
    "    if (c == EOF && n == 0) return 0;\n",
    "    if (linha_tokens == NULL) {\n",
    "        linha_tokens = (char *)malloc(1);\n",
    "        if (linha_tokens == NULL) exit(2);\n",
    "        capacidade_tokens = 1;\n",
    "    }\n",
    "    linha_tokens[n] = '\\0';\n",
    "    numero_registro++;\n",
    "    return 1;\n",
    "}\n",
    "\n",
    "static void espacos_lista(char **p)\n",
    "{\n",
    "    while (isspace((unsigned char)**p)) (*p)++;\n",
    "}\n",
    "\n",
    "static int campo_lista(char **p, const char *campo)\n",
    "{\n",
    "    size_t n;\n",
    "    espacos_lista(p);\n",
    "    n = strlen(campo);\n",
    "    if (strncmp(*p, campo, n) != 0) return 0;\n",
    "    *p += n;\n",
    "    return 1;\n",
    "}\n",
    "\n",
    "static int numero_lista(char **p, int *valor)\n",
    "{\n",
    "    char *fim;\n",
    "    long n;\n",
    "    espacos_lista(p);\n",
    "    if (!isdigit((unsigned char)**p)) return 0;\n",
    "    errno = 0;\n",
    "    n = strtol(*p, &fim, 10);\n",
    "    if (errno == ERANGE || n < 1 || n > INT_MAX) return 0;\n",
    "    *valor = (int)n;\n",
    "    *p = fim;\n",
    "    return 1;\n",
    "}\n",
    "\n",
    "static int hexadecimal(int c)\n",
    "{\n",
    "    if (c >= '0' && c <= '9') return c - '0';\n",
    "    if (c >= 'a' && c <= 'f') return c - 'a' + 10;\n",
    "    if (c >= 'A' && c <= 'F') return c - 'A' + 10;\n",
    "    return -1;\n",
    "}\n",
    "\n",
    "static Token proximo_token_lista(void)\n",
    "{\n",
    "    Token t;\n",
    "    char *p;\n",
    "    char *nome;\n",
    "    char *inicio;\n",
    "    char *fim;\n",
    "    char *saida;\n",
    "    size_t n;\n",
    "    int i;\n",
    "    int c;\n",
    "    int a;\n",
    "    int b;\n",
    "    memset(&t, 0, sizeof(t));\n",
    "    t.tipo = T_UNDEF;\n",
    "    t.linha = numero_registro + 1;\n",
    "    t.coluna = 1;\n",
    "    t.lexema = \"\";\n",
    "    t.erro = \"registro invalido na lista de tokens\";\n",
    "    do {\n",
    "        if (!ler_linha_tokens()) {\n",
    "            t.tipo = T_END_OF_FILE;\n",
    "            t.erro = NULL;\n",
    "            return t;\n",
    "        }\n",
    "        p = linha_tokens;\n",
    "        espacos_lista(&p);\n",
    "    } while (*p == '\\0');\n",
    "    if (strncmp(p, \"ERRO LEXICO\", 11) == 0) {\n",
    "        t.erro = p;\n",
    "        return t;\n",
    "    }\n",
    "    if (!campo_lista(&p, \"Token:\") || !campo_lista(&p, \"tipo\") ||\n",
    "        !campo_lista(&p, \"=\")) return t;\n",
    "    espacos_lista(&p);\n",
    "    nome = p;\n",
    "    while (*p && !isspace((unsigned char)*p)) p++;\n",
    "    n = (size_t)(p - nome);\n",
    "    t.tipo = -1;\n",
    "    for (i = 0; i <= T_END_OF_FILE; i++) {\n",
    "        if (strlen(nomes_tokens[i]) == n && strncmp(nome, nomes_tokens[i], n) == 0)\n",
    "            t.tipo = i;\n",
    "    }\n",
    "    if (n == 11 && strncmp(nome, \"END_OF_FILE\", 11) == 0)\n",
    "        t.tipo = T_END_OF_FILE;\n",
    "    if (t.tipo < 0) {\n",
    "        t.tipo = T_UNDEF;\n",
    "        t.erro = \"tipo desconhecido na lista de tokens\";\n",
    "        return t;\n",
    "    }\n",
    "    i = t.tipo;\n",
    "    t.tipo = T_UNDEF;\n",
    "    if (!campo_lista(&p, \"lexema\") || !campo_lista(&p, \"=\") ||\n",
    "        !campo_lista(&p, \"'\")) return t;\n",
    "    inicio = p;\n",
    "    while (*p && *p != '\\'') {\n",
    "        if (*p == '\\\\') {\n",
    "            p++;\n",
    "            if (!*p) return t;\n",
    "        }\n",
    "        p++;\n",
    "    }\n",
    "    if (*p != '\\'') return t;\n",
    "    fim = p++;\n",
    "    if (!campo_lista(&p, \"linha\") || !campo_lista(&p, \"=\") ||\n",
    "        !numero_lista(&p, &t.linha)) return t;\n",
    "    espacos_lista(&p);\n",
    "    if (*p) {\n",
    "        if (!campo_lista(&p, \"coluna\") || !campo_lista(&p, \"=\") ||\n",
    "            !numero_lista(&p, &t.coluna)) return t;\n",
    "    }\n",
    "    espacos_lista(&p);\n",
    "    if (*p) return t;\n",
    "    saida = inicio;\n",
    "    for (p = inicio; p < fim; p++) {\n",
    "        c = (unsigned char)*p;\n",
    "        if (c == '\\\\') {\n",
    "            p++;\n",
    "            c = (unsigned char)*p;\n",
    "            if (c == 'n') c = '\\n';\n",
    "            else if (c == 't') c = '\\t';\n",
    "            else if (c == 'r') c = '\\r';\n",
    "            else if (c == '0') c = 0;\n",
    "            else if (c == 'x') {\n",
    "                if (fim - p < 3) return t;\n",
    "                a = hexadecimal((unsigned char)p[1]);\n",
    "                b = hexadecimal((unsigned char)p[2]);\n",
    "                if (a < 0 || b < 0) return t;\n",
    "                c = a * 16 + b;\n",
    "                p += 2;\n",
    "            } else if (c != '\\\\' && c != '\\'' && c != '\"') return t;\n",
    "        }\n",
    "        *saida++ = (char)c;\n",
    "    }\n",
    "    *saida = '\\0';\n",
    "    if (saida - inicio > INT_MAX) return t;\n",
    "    t.lexema = inicio;\n",
    "    t.tamanho = (int)(saida - inicio);\n",
    "    t.tipo = i;\n",
    "    t.erro = i == T_UNDEF ? inicio : NULL;\n",
    "    if (i == T_END_OF_FILE) {\n",
    "        while ((c = fgetc(arquivo_tokens)) != EOF) {\n",
    "            if (!isspace((unsigned char)c)) {\n",
    "                t.tipo = T_UNDEF;\n",
    "                t.erro = \"dados apos END_OF_FILE\";\n",
    "                break;\n",
    "            }\n",
    "        }\n",
    "    }\n",
    "    return t;\n",
    "}\n",
    "\n",
    "static void fechar_lista(void)\n",
    "{\n",
    "    if (arquivo_tokens != NULL) fclose(arquivo_tokens);\n",
    "    arquivo_tokens = NULL;\n",
    "    free(linha_tokens);\n",
    "    linha_tokens = NULL;\n",
    "    capacidade_tokens = 0;\n",
    "    numero_registro = 0;\n",
    "}\n",
    "\n",
